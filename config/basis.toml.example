[server]
host = "0.0.0.0"
port = 3048
# Base directory for all on-disk storage (databases, indices, scanner metadata).
# Defaults to "data" relative to the server's working directory.
data_dir = "data"
# Legacy database URL field, kept for compatibility. Currently unused.
database_url = "sqlite:data/basis.db"
# Path to PEM-encoded TLS certificate chain. When both this and tls_key_path are
# set, the server listens on HTTPS.
# tls_cert_path = "server.crt"
# Path to PEM-encoded TLS private key.
# tls_key_path = "server.key"
# Maximum nanoERG a single /reserves/create payload may carry (default 10 ERG).
# reserve_creation_max_erg_nano = 10000000000
# Maximum token units a single /reserves/create payload may carry in token-reserve mode.
# reserve_creation_max_token_amount = 1000000000
# Maximum /redemption/build calls per (issuer, recipient) pair per hour; bounds the
# fee cost a self-redeeming user can impose on the tracker wallet (default 60).
# redemption_build_max_per_pair_per_hour = 60

[server.auth]
# Authentication mode: "none", "api_key", or "signature".
#
# SECURITY: "none" grants EVERY caller Admin. The server therefore refuses to start with
# mode = "none" unless it is bound to a loopback address (127.0.0.1 / ::1 / "localhost").
# Set one of the authenticated modes, or bind to loopback.
mode = "none"
# Escape hatch for the rule above. Leave false unless you have a specific reason: it re-exposes a
# full admin API (including the tracker's wallet) to the network.
# allow_anonymous_non_loopback = false
# Shared API key for server-to-server / MCP clients when mode = "api_key".
# The literal "change-me" is rejected at startup; use a strong random key.
# api_key = "change-me"
# Separate operator credential for Admin routes (/reserves/create, /acceptance/policy,
# /redeem/complete). When set, `api_key` grants only Write access, so the key shared
# with ordinary clients cannot drive operator-only endpoints. When unset, `api_key`
# keeps its full Admin meaning (a startup warning is printed in that case).
# admin_api_key = "change-me-admin"
# Escape hatch: allow authenticated operation over plain HTTP on a non-loopback bind.
# Without TLS, API keys and signatures travel unencrypted. Leave false.
# allow_insecure_http_non_loopback = false
# Authorized clients when mode = "signature". Each entry has a 66-character
# compressed secp256k1 public key and a role: "read", "write", or "admin".
# [[server.auth.authorized_clients]]
# pubkey = "020202020202020202020202020202020202020202020202020202020202020202"
# role = "read"
# Origins allowed by CORS. Leave empty to disable CORS entirely: no CORS
# headers are emitted, so only same-origin or non-browser clients can connect.
# List explicit origins to allow cross-origin browser clients.
allowed_origins = []
# Request signature timestamp tolerance in milliseconds (signature mode only).
signature_timestamp_tolerance_ms = 30000

[ergo]
basis_reserve_contract_p2s = ""
# P2S address for token-backed reserves (basis-token.es). Required only when reserve_token_id is set.
basis_token_reserve_contract_p2s = ""
# Tracker NFT ID (hex-encoded) - required for reserve creation and redemption
# This NFT identifies the tracker server and must be set in reserve contract R6 register.
# Mint it with supply 1 (singleton): tracker boxes holding more than one token are rejected.
tracker_nft_id = "your_tracker_nft_token_id_here"
# Reserve token ID (hex-encoded, 32 bytes). When set, new reserves are backed by this token.
# Example for USE (Dexy USD): a55b8735ed1a99e46c2c89f8994aacdf4b1109bdcf682f1e5b34479c6e392669
reserve_token_id = ""
# Decimal places of the reserve token, for display only. Raw on-chain amounts are always integer units.
# USE uses 3 decimals (as reported by the Ergo node token registry).
reserve_token_decimals = 3
# Tracker public key - can be hex-encoded public key or P2PK address
tracker_public_key = "your_tracker_public_key_or_p2pk_address_here"
# Tracker secret key for local signing (hex-encoded, 32 bytes)
# If provided, the server will sign redemption transactions locally instead of using the Ergo node API
# WARNING: never commit this value to version control
tracker_secret_key = "your_tracker_secret_key_here"

[ergo.node]
start_height = 0
node_url = "http://127.0.0.1:9053"
api_key = "your_node_api_key_here"
timeout_secs = 30

[transaction]
# Default transaction fee in nanoERG (0.001 ERG = 1,000,000 nanoERG)
fee = 1000000

[redemption]
# Enforce acceptance-policy compliance at redemption time: reject redemptions that
# would newly violate another debt holder's collateralization policy. When all other
# holders are already violated (distressed reserve), only the oldest outstanding
# note may redeem (FIFO fallback). Emergency redemptions bypass this check.
enforce_acceptance_policy = true

[confirmation]
# Minimum on-chain depth (including the inclusion block) before a tracker box update
# is treated as confirmed and pending notes become redeemable. Presence of the update
# transaction in a block alone is not confirmation.
min_depth = 2
