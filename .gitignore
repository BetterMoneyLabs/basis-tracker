# Generated by Cargo
# will have compiled files and executables
debug
target
.idea
.crush
data

# Local configuration files containing secrets
config/basis.toml

# process id file
server.pid

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

*.log 

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Crush context file
.crush_context

# Implementation plans (not meant for git)
tracker_box_scan_plan.md

# Alice and Bob keys/secrets
alice.txt
bob.txt
secret.txt
alice_keys_output.txt

# Local secret files (test fixtures may be committed)
secrets/participants.local.csv

# SECURITY (PR #14 S7): participant secrets must never be committed. This file previously held
# live mainnet-format keys while its own header said it "should NOT be committed"; the keys are
# public now and must be rotated. Copy secrets/participants.csv.template and fill it in locally.
secrets/participants.csv

# Per-demo tracker configs carry a real tracker_secret_key; the checked-in copy under
# demo/agent_celaut_use/config/basis.toml was removed for the same reason. The other demos inject
# the key from $TRACKER_SECRET at run time.
demo/*/config/basis.toml

# Demo output files
demo/output/

# Test output files
test_output/

# Test tracker storage (created during integration tests)
test_tracker/

# Test policies directories (created during acceptance tests)
test_policies_*/

# Python bytecode
__pycache__/
*.pyc
